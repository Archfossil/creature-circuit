{
  "name": "creature-circuit",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "baseline": "node scripts/test.mjs --baseline",
    "test:watch": "vitest",
    "start": "node server/index.mjs",
    "server": "node server/index.mjs",
    "debug:saves": "vite-node scripts/debug-save.ts",
    "docs:creatures": "vite-node scripts/creature-checklist.ts",
    "docs:moves": "vite-node scripts/move-checklist.ts",
    "docs:instincts": "vite-node scripts/instinct-checklist.ts"
  },
  "dependencies": {
    "three": "^0.170.0",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/three": "^0.170.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.6",
    "vite-node": "^3.2.4",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
